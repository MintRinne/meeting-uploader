# === Google Drive (원본, read-only) ===
# 서비스 계정 JSON 키 파일 경로. Shared Drive 에 이 계정을 뷰어로 추가해야 함.
GDRIVE_SA_KEY_PATH=./secrets/gdrive-sa.json
# 회의록이 들어있는 Shared Drive 폴더 ID (백필/폴백 스캔 대상)
GDRIVE_FOLDER_ID=

# === 그룹웨어 REST API ===
GROUPWARE_BASE_URL=https://groupware.example.com
GROUPWARE_API_TOKEN=
GROUPWARE_BOARD_ID=

# === Git 미러 저장소 (아카이브 + 파이프라인 상태 저장소) ===
ARCHIVE_REPO_URL=git@github.com:your-org/meeting-archive.git
ARCHIVE_WORK_DIR=.work/meeting-archive
# 로컬 개발 중에는 false 로 두면 push 를 건너뜀
ARCHIVE_PUSH=true

# === 동작 옵션 ===
DRY_RUN=false
# 최근 N분 이내 수정된 파일은 이번 회차에서 건너뜀 (저장 도중 방지)
MIN_FILE_AGE_MINUTES=10
SLACK_WEBHOOK_URL=
